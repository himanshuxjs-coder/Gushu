# Public Supabase configuration. These values are included in the client build.
# A publishable/anon key is not a secret; protect data with Supabase RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side Supabase configuration for TanStack server functions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Privileged server-only key used by admin operations. Never prefix with VITE_,
# commit a real value, or place it in the APK/client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
